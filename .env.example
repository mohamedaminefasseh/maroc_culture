# Destination email for itinerary requests
ITINERARY_TO_EMAIL=mohamedamine.fasseh@e-polytechnique.ma

# SMTP settings are required for automatic email sending.
# Gmail example: use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Discover Morocco <your_email@gmail.com>

# Optional
PORT=3000
